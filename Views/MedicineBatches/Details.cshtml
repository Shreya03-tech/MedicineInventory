@model MedicineInventory.Models.MedicineBatch
@{
    ViewData["Title"] = "Batch Details";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h2 mb-1">Batch Details</h1><p class="text-muted mb-0">@Model.Medicine?.Name — @Model.BatchNumber</p></div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Batch</a>
</div>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Medicine</dt><dd class="col-sm-8">@Model.Medicine?.Name</dd>
        <dt class="col-sm-4">Batch number</dt><dd class="col-sm-8">@Model.BatchNumber</dd>
        <dt class="col-sm-4">Quantity</dt><dd class="col-sm-8">@Model.Quantity</dd>
        <dt class="col-sm-4">Manufacturing date</dt><dd class="col-sm-8">@Model.ManufacturingDate.ToString("dd MMM yyyy")</dd>
        <dt class="col-sm-4">Expiry date</dt><dd class="col-sm-8">@Model.ExpiryDate.ToString("dd MMM yyyy")</dd>
        <dt class="col-sm-4">Expiry status</dt><dd class="col-sm-8">@Model.ExpiryStatus</dd>
        <dt class="col-sm-4">Purchase price</dt><dd class="col-sm-8">@Model.PurchasePrice.ToString("C")</dd>
        <dt class="col-sm-4">Selling price</dt><dd class="col-sm-8">@Model.SellingPrice.ToString("C")</dd>
        <dt class="col-sm-4">Supplier</dt><dd class="col-sm-8">@Model.SupplierName</dd>
    </dl>
</div></div>
<div class="mt-3">
    <a asp-action="Index" asp-route-medicineId="@Model.MedicineId" class="btn btn-outline-secondary">Back to Batches</a>
</div>
