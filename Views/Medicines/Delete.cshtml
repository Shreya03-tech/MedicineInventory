
@model MedicineInventory.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<h1 class="fw-bold mb-3">Delete Medicine</h1>

<div class="alert alert-warning">
    <strong>Warning:</strong> Deleting this medicine will also delete all its associated batches. This action cannot be undone.
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <h4>@Model.Name</h4>
        <p class="text-muted">@Model.Category</p>

        <dl class="row">
            <dt class="col-sm-4">Manufacturer</dt>
            <dd class="col-sm-8">@Model.Manufacturer</dd>

            <dt class="col-sm-4">Total Quantity</dt>
            <dd class="col-sm-8">@Model.TotalQuantity</dd>

            <dt class="col-sm-4">Minimum Stock Threshold</dt>
            <dd class="col-sm-8">@Model.MinimumStockThreshold</dd>

            <dt class="col-sm-4">Number of Batches</dt>
            <dd class="col-sm-8">@Model.BatchCount</dd>
        </dl>

        @if (Model.Batches.Any())
        {
            <h5 class="mt-4">Associated Batches</h5>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Batch Number</th>
                            <th>Quantity</th>
                            <th>Expiry Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in Model.Batches)
                        {
                            <tr>
                                <td>@batch.BatchNumber</td>
                                <td>@batch.Quantity</td>
                                <td>@batch.ExpiryDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
