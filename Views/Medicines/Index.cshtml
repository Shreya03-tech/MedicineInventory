@model IEnumerable<MedicineInventory.Models.Medicine>

@{
    ViewData["Title"] = "Medicine Inventory";
    var currentStatus = ViewBag.Status as string ?? "";
    var currentSort = ViewBag.SortOrder as string ?? "";
    var currentSearch = ViewBag.SearchString as string ?? "";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Medicine Inventory</h1>
            <p class="text-secondary mb-0">
                Search, monitor, and manage your medicine stock.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">+ Add Medicine</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Find Medicines</h5>

            <form asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-4">
                        <label for="searchString" class="form-label">Search</label>
                        <input type="text" id="searchString" name="searchString" value="@currentSearch"
                               class="form-control" placeholder="Medicine, batch, manufacturer..." />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="status" class="form-label">Expiry / Stock Status</label>
                        <select id="status" name="status" class="form-select">
                            <option value="" selected="@(currentStatus == "")">All Medicines</option>
                            <option value="expired" selected="@(currentStatus == "expired")">Expired</option>
                            <option value="expiring-soon" selected="@(currentStatus == "expiring-soon")">Expiring Within
                                30 Days</option>
                                <option value="within-90-days" selected="@(currentStatus == "within-90-days")">Within 31–90
                                    Days</option>
                                    <option value="safe" selected="@(currentStatus == "safe")">Safe (Over 90 Days)</option>
                                    <option value="low-stock" selected="@(currentStatus == "low-stock")">Low Stock</option>
                                </select>
                            </div>

                            <div class="col-12 col-sm-6 col-lg-3">
                                <label for="sortOrder" class="form-label">Sort By</label>
                                <select id="sortOrder" name="sortOrder" class="form-select">
                                    <option value="" selected="@(currentSort == "")">Name (A–Z)</option>
                                    <option value="name_desc" selected="@(currentSort == "name_desc")">Name (Z–A)</option>
                                    <option value="expiry_asc" selected="@(currentSort == "expiry_asc")">Earliest Expiry
                                    </option>
                                    <option value="expiry_desc" selected="@(currentSort == "expiry_desc")">Latest Expiry
                                    </option>
                                    <option value="quantity_asc" selected="@(currentSort == "quantity_asc")">Quantity (Low–High)
                                    </option>
                                    <option value="quantity_desc" selected="@(currentSort == "quantity_desc")">Quantity
                                        (High–Low)</option>
                                    </select>
                                </div>

                                <div class="col-12 col-lg-2 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary flex-grow-1">
                                        Search
                                    </button>
                                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Medicine Records</h5>
                    <span class="badge text-bg-secondary">@Model.Count() record(s)</span>
                </div>

                <div class="card border-0 shadow-sm">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Medicine</th>
                                        <th>Batch Numbers</th>
                                        <th>Category</th>
                                        <th>Total Quantity</th>
                                        <th>Nearest Expiry</th>
                                        <th>Expiry Status</th>
                                        <th>Stock Status</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var medicine in Model)
                                    {
                                        var batches = medicine.Batches
                                            .OrderBy(b => b.ExpiryDate)
                                            .ToList();

                                        var stockedBatches = batches
                                            .Where(b => b.Quantity > 0)
                                            .ToList();

                                        var nearestBatch = stockedBatches.FirstOrDefault();

                                        var expiryStatuses = stockedBatches
                                            .Select(b => b.ExpiryStatus)
                                            .Distinct()
                                            .ToList();

                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-semibold">@medicine.Name</div>
                                                <small class="text-secondary">@medicine.Manufacturer</small>
                                            </td>

                                            <td>
                                                @if (batches.Any())
                                                {
                                                    @foreach (var batch in batches.Take(2))
                                                    {
                                                        <div><span class="font-monospace">@batch.BatchNumber</span></div>
                                                    }

                                                    @if (batches.Count > 2)
                                                    {
                                                        <small class="text-secondary">
                                                            +@(batches.Count - 2) more
                                                        </small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">No batches</span>
                                                }
                                            </td>

                                            <td>@medicine.Category</td>

                                            <td>
                                                <span class="fw-semibold">@medicine.TotalQuantity</span>
                                                <small class="text-secondary d-block">
                                                    @batches.Count batch(es)
                                                </small>
                                            </td>

                                            <td>
                                                @if (nearestBatch != null)
                                                {
                                                    @nearestBatch.ExpiryDate.ToString("dd MMM yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">—</span>
                                                }
                                            </td>

                                            <td>
                                                @if (!expiryStatuses.Any())
                                                {
                                                    <span class="badge bg-secondary">No Active Stock</span>
                                                }
                                                else
                                                {
                                                    @foreach (var expiryStatus in expiryStatuses)
                                                    {
                                                        switch (expiryStatus)
                                                        {
                                                            case "Expired":
                                                                <span class="badge bg-danger me-1 mb-1">Expired</span>
                                                                break;

                                                            case "Expiring Soon":
                                                                <span class="badge bg-warning text-dark me-1 mb-1">Expiring Soon</span>
                                                                break;

                                                            case "Expiring Within 90 Days":
                                                                <span class="badge bg-info text-dark me-1 mb-1">Within 90 Days</span>
                                                                break;

                                                            default:
                                                                <span class="badge bg-success me-1 mb-1">Safe</span>
                                                                break;
                                                        }
                                                    }
                                                }
                                            </td>

                                            <td>
                                                @if (medicine.IsLowStock)
                                                {
                                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Sufficient</span>
                                                }
                                            </td>

                               
                                            <td class="text-end pe-4">
                                                <div class="d-inline-flex flex-nowrap justify-content-end gap-1">
                                                    <a asp-action="Details" asp-route-id="@medicine.Id"
                                                       class="btn btn-sm btn-outline-secondary px-2 py-1">
                                                        View
                                                    </a>

                                                    <a asp-action="Edit" asp-route-id="@medicine.Id"
                                                       class="btn btn-sm btn-outline-primary px-2 py-1">
                                                        Edit
                                                    </a>

                                                    <a asp-action="Delete" asp-route-id="@medicine.Id"
                                                       class="btn btn-sm btn-outline-danger px-2 py-1">
                                                        Delete
                                                    </a>
                                                </div>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 px-3">
                            <div class="mb-3">
                                <icon name="package-search" size="3xl" />
                            </div>
                            <h5 class="fw-bold">No medicines found</h5>
                            <p class="text-secondary">
                                Try changing your search or filter, or add a new medicine.
                            </p>
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">Clear Filters</a>
                            <a asp-action="Create" class="btn btn-primary">Add Medicine</a>
                        </div>
                    }
                </div>
            </div>
